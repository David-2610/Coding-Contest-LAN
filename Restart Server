#!/usr/bin/env bash
set -euo pipefail
if [[ ! -t 0 && -n ${DISPLAY:-} && ${1:-} != --terminal ]]; then
    exec x-terminal-emulator -e "$0" --terminal
fi

echo "=================================================="
echo "   Restarting CodeClash Contest Server & Services "
echo "=================================================="
project=$(cd -- "$(dirname -- "$0")" && pwd)
cd "$project/Coding Contest Server/backend"
export LD_LIBRARY_PATH="$PWD/var/maria-runtime/usr/lib/x86_64-linux-gnu"

echo "[1/4] Rebuilding frontend static assets..."
(cd ../frontend && ./node_modules/esbuild/bin/esbuild src/site.jsx --bundle --minify --outfile=dist/workspace.js)
.venv/bin/python manage.py collectstatic --noinput -v0

echo "[2/4] Restarting Web Server, Judge Worker & Presence Services..."
scripts/server restart

echo "[3/4] Checking database connection..."
.venv/bin/python manage.py shell -c 'from django.db import connection; connection.ensure_connection(); print("Database connection: OK")'

echo "[4/4] Verifying active pilot services..."
scripts/server status

echo "--------------------------------------------------"
echo "✅ CodeClash Server & Judge restarted successfully!"
echo "   Contest URL: http://codeclash.test/login/"
echo "   Organizer:   http://127.0.0.1:8765/organizer/"
echo "--------------------------------------------------"
if [[ -t 0 ]]; then
    read -rp "Press Enter to close."
fi
