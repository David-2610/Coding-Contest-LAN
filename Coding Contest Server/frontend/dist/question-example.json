  "signature": {
    "params": [
      ["nums", "int[]"],
      ["target", "int"]
    ],
    "returns": "int[]"
  },
  "constraints": [
    "2 <= nums.length <= 10^4",
    "-10^9 <= nums[i] <= 10^9",
    "-10^9 <= target <= 10^9",
    "Only one valid answer exists."
  ],
  "examples": [
