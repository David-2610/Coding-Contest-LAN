{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeClash LeetCode Format Question",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "title": {
      "type": "string",
      "maxLength": 120,
      "minLength": 1
    },
    "difficulty": {
      "enum": [
        "Easy",
        "Medium",
        "Hard"
      ]
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 100
      },
      "minItems": 1
    },
    "description": {
      "type": "string"
    },
    "function": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "signature": {
      "type": "object",
      "properties": {
        "params": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string"
            }
          }
        },
        "returns": {
          "type": "string"
        }
      },
      "required": [
        "params",
        "returns"
      ]
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "testCases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "visibility": {
            "enum": [
              "public",
              "hidden"
            ]
          },
          "weight": {
            "type": "integer"
          }
        },
        "required": [
          "id"
        ]
      },
      "minItems": 1
    },
    "execution": {
      "type": "object",
      "properties": {
        "timeLimitMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 15000
        },
        "memoryLimitMB": {
          "type": "integer",
          "minimum": 32,
          "maximum": 1024
        }
      }
    },
    "scoring": {
      "type": "object",
      "properties": {
        "maxScore": {
          "type": "integer"
        },
        "method": {
          "type": "string"
        }
      }
    },
    "languages": {
      "type": "object"
    }
  },
  "required": [
    "id",
    "title",
    "description"
  ]
}
